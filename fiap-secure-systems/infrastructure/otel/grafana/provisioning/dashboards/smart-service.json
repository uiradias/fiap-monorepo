{
  "title": "smart-service",
  "uid": "fss-smart",
  "schemaVersion": 39,
  "tags": ["fiap-secure-systems", "smart-service"],
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "smart-service running",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "(count(http_server_active_requests{job=\"smart-service\"}) > bool 0) or vector(0)",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "HTTP request rate (req/s, by status)",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "sum by (http_status_code) (rate(http_server_duration_milliseconds_count{job=\"smart-service\"}[1m]))",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "{{http_status_code}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Anthropic call duration p95 (ms)",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(anthropic_call_duration_ms_bucket[5m])))",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "p95"
        }
      ]
    }
  ]
}
