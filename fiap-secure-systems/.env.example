# === LocalStack / AWS SDK ===
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# Presigned S3 URLs open in your browser — must use a hostname/port reachable from the host
# machine (not Docker-internal DNS like "localstack"). Docker Compose sets a sensible default.
GATEWAY_S3_PRESIGN_ENDPOINT_URL=http://localhost:4566

# Resource names (also defined in compose; here for app services)
S3_BUCKET=fiap-secure-systems-assets
SNS_TOPIC_SESSION_EVENTS=arn:aws:sns:us-east-1:000000000000:session-events
SQS_ANALYSIS_JOBS_URL=http://localstack:4566/000000000000/analysis-jobs
SQS_ANALYSIS_RESULTS_URL=http://localstack:4566/000000000000/analysis-results
SQS_ANALYSIS_RESULTS_DLQ_URL=http://localstack:4566/000000000000/analysis-results-dlq
SQS_SESSION_EVENTS_GATEWAY_URL=http://localstack:4566/000000000000/session-events-gateway

# === Postgres ===
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
GATEWAY_DB=gateway_db
ORCHESTRATOR_DB=orchestrator_db
SMART_DB=smart_db

# Per-service DB credentials (created by infrastructure/postgres/init/02-create-service-roles.sql)
SMART_DB_USER=smart_user
SMART_DB_PASSWORD=smart_pwd
SMART_DATABASE_URL=postgresql+psycopg://smart_user:smart_pwd@postgres:5432/smart_db
ORCHESTRATOR_DB_USER=orchestrator_user
ORCHESTRATOR_DB_PASSWORD=orchestrator_pwd
ORCHESTRATOR_DATABASE_URL=jdbc:postgresql://postgres:5432/orchestrator_db
GATEWAY_DB_USER=gateway_user
GATEWAY_DB_PASSWORD=gateway_pwd
GATEWAY_DATABASE_URL=jdbc:postgresql://postgres:5432/gateway_db

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Java services push Micrometer metrics via OTLP/HTTP; collector listens on 4318.
OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=http://otel-collector:4318/v1/metrics

# === Service-specific ===
# smart-service only; never commit a real value
ANTHROPIC_API_KEY=
# smart-service: model id
ANTHROPIC_MODEL=claude-sonnet-4-6
# 'production' uses real Claude; 'e2e' uses FakeAnalysisModel
SMART_SERVICE_PROFILE=production
INTERNAL_HMAC_SECRET=change-me-32-bytes-min-for-real-deployments
# orchestrator-service
SPRING_PROFILES_ACTIVE=
ORCHESTRATOR_OUTBOX_RELAY_INTERVAL_MS=500
ORCHESTRATOR_OUTBOX_RELAY_BATCH_SIZE=20
ORCHESTRATOR_SQS_RESULTS_POLL_WAIT_SECONDS=10
# gateway-service only; generated locally
JWT_PRIVATE_KEY_PATH=/run/jwt/jwt-private.pem
JWT_PUBLIC_KEY_PATH=/run/jwt/jwt-public.pem

# gateway-service
GATEWAY_PORT=8080
GATEWAY_INTERNAL_HMAC_SECRET=change-me-32-bytes-min-for-real-deployments
GATEWAY_RATE_LIMIT_AUTHED_PER_MINUTE=60
GATEWAY_RATE_LIMIT_ANON_PER_MINUTE=10
GATEWAY_WEBSOCKET_SNAPSHOT_EVENTS=50
GATEWAY_SQS_SESSION_EVENTS_POLL_WAIT_SECONDS=10
GATEWAY_ORCHESTRATOR_BASE_URL=http://orchestrator-service:8081

# frontend
VITE_GATEWAY_BASE_URL=http://localhost:8080
VITE_GATEWAY_WS_URL=ws://localhost:8080
FRONTEND_PORT=5173

# === RAG / grounded analysis (Task 12) ===
# Only needed when SMART_ANALYSIS_STRATEGY=grounded
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3

SMART_ANALYSIS_STRATEGY=baseline
SMART_HAIKU_MODEL=claude-haiku-4-5-20251001
SMART_EMBEDDING_DIM=1024
SMART_RAG_TOPK_COMPONENT=3
SMART_RAG_TOPK_TOPOLOGY=5
