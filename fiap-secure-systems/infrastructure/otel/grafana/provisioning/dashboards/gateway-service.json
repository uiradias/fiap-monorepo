{
  "title": "gateway-service",
  "uid": "fss-gateway",
  "schemaVersion": 39,
  "tags": ["fiap-secure-systems", "gateway-service"],
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "id": 1,
      "title": "gateway-service running",
      "gridPos": { "x": 0, "y": 0, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "up{job=\"gateway-service\"}",
          "datasource": { "type": "prometheus", "uid": "prometheus" }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ]
        }
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Public REST p95 latency (ms, by URI)",
      "gridPos": { "x": 4, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_milliseconds_bucket{job=\"gateway-service\"}[5m])))",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "p95 {{uri}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "WebSocket connection count",
      "gridPos": { "x": 14, "y": 0, "w": 10, "h": 8 },
      "targets": [
        {
          "expr": "fss_ws_subscribers{job=\"gateway-service\"}",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "open WS"
        }
      ]
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Auth flow rate (login / register / refresh)",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (uri) (rate(http_server_requests_milliseconds_count{job=\"gateway-service\",uri=~\"/api/v1/auth/.*\"}[1m]))",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "legendFormat": "{{uri}}"
        }
      ]
    }
  ]
}
